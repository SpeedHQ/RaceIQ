{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["game"],
  "tasks": {
    "transit": {
      "inputs": ["$TURBO_EXTENDS$", "test/fixtures/sessions/*.bin.gz"]
    },
    "test": {
      "dependsOn": ["@raceiq/game-lmu-tests#transit"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/game-lmu/test/**/*.ts", "$TURBO_ROOT$/packages/game-lmu/test/**/*.tsx", "$TURBO_ROOT$/packages/game-lmu/test/**/*.json", "$TURBO_ROOT$/packages/game-lmu/test/*-files.txt", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/**/*.bin.gz", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/**/*.part*"]
    },
    "test:integration": {
      "dependsOn": ["@raceiq/game-lmu-tests#transit"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/game-lmu/test/**/*.ts", "$TURBO_ROOT$/packages/game-lmu/test/**/*.tsx", "$TURBO_ROOT$/packages/game-lmu/test/**/*.json", "$TURBO_ROOT$/packages/game-lmu/test/*-files.txt", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/sessions/*.bin.gz"]
    },
    "test:unit": {
      "dependsOn": ["@raceiq/game-lmu-tests#transit"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/game-lmu/test/**/*.ts", "$TURBO_ROOT$/packages/game-lmu/test/**/*.tsx", "$TURBO_ROOT$/packages/game-lmu/test/**/*.json", "$TURBO_ROOT$/packages/game-lmu/test/*-files.txt", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/sessions/*.bin.gz"]
    },
    "test:e2e:recordings": {
      "cache": false,
      "dependsOn": ["@raceiq/game-lmu-tests#transit"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/game-lmu/test/**/*.ts", "$TURBO_ROOT$/packages/game-lmu/test/**/*.tsx", "$TURBO_ROOT$/packages/game-lmu/test/**/*.json", "$TURBO_ROOT$/packages/game-lmu/test/*-files.txt", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/**/*.bin.gz", "$TURBO_ROOT$/packages/game-lmu/test/fixtures/**/*.part*"]
    }
  }
}
