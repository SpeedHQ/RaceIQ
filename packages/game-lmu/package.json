{
  "name": "@raceiq/game-lmu",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./import-duckdb": "./src/import-duckdb.ts",
    "./setup-directory": "./src/setup-directory.ts",
    "./normalizer": "./src/normalizer.ts",
    "./source": "./src/source.ts",
    "./test-support/duckdb": "./test/support/duckdb.ts",
    "./test-support/recordings": "./test/support/recordings.ts",
    "./game-parser": "./src/game-parser.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.2",
    "@raceiq/capture-formats": "workspace:*",
    "@raceiq/shared": "workspace:*",
    "@raceiq/backend-core": "workspace:*",
    "@raceiq/game-lmu-metadata": "workspace:*",
    "@raceiq/analysis-core": "workspace:*",
    "@raceiq/telemetry-core": "workspace:*"
  },
  "scripts": {
    "typecheck": "bunx tsc --project tsconfig.json --noEmit",
    "test": "bun ../../scripts/test/run-suite.ts all --package @raceiq/game-lmu",
    "test:e2e:recordings": "bun ../../scripts/test/run-suite.ts e2e --package @raceiq/game-lmu",
    "test:integration": "bun ../../scripts/test/run-suite.ts integration --package @raceiq/game-lmu"
  }
}
