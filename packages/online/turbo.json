{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["composition"],
  "tasks": {
    "transit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**"
      ]
    },
    "e2e:impact": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/client/src/features/online-host.tsx"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/server/test-support/setup-data-dir.ts"
      ]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/server/test-support/setup-data-dir.ts"
      ]
    }
  }
}
