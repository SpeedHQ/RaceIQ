  "scripts": {
    "typecheck": "bun check --project tsconfig.ui.json && bun check --project tsconfig.server.json && bun check --project tsconfig.json",
    "lint": "../../client/node_modules/.bin/oxlint .",
    "test:boundaries": "bun ../../scripts/test/check-feature-boundaries.ts online",
    "e2e:impact": "bun ../../scripts/test/check-feature-boundaries.ts online",
    "test:e2e": "cd ../../playwright && E2E_SERVER_MODE=compiled PW_SERVER_SET=seeded PW_SEEDED_E2E_PORT=3126 PW_SEEDED_E2E_CLIENT_PORT=4126 PW_SEEDED_E2E_UDP_PORT=15326 PW_SEEDED_E2E_DATA_DIR=./test-results/test-data-online RACEIQ_FEATURE_F1_EXPERIMENTS=true RACEIQ_FEATURE_IRACING_ADAPTER=true bun ../scripts/playwright-ci.ts test --config=playwright.config.ts --project=online --output=test-results/online",
    "test": "bun ../../scripts/test/run-suite.ts all --package @raceiq/online",
    "test:unit": "bun ../../scripts/test/run-suite.ts unit --package @raceiq/online",
    "test:integration": "bun ../../scripts/test/run-suite.ts integration --package @raceiq/online"
  },
  "dependencies": {
