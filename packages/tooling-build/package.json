{
  "name": "@raceiq/tooling-build",
  "private": true,
  "type": "module",
  "exports": {
    "./build/copy-duckdb-runtime": "./src/build/copy-duckdb-runtime.ts"
  },
  "dependencies": {
    "@raceiq/shared": "workspace:*",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "^0.35.5",
    "@duckdb/node-api": "2.0.1-r.1"
  },
  "scripts": {
    "lint": "node ../../client/node_modules/oxlint/bin/oxlint .",
    "build": "cd ../.. && bun packages/tooling-build/src/build/build.ts",
    "build:e2e": "cd ../.. && bun scripts/build-browser.ts",
    "typecheck": "bun check --project tsconfig.json",
    "test": "bun ../../scripts/test/run-suite.ts all --package @raceiq/tooling-build",
    "test:unit": "bun ../../scripts/test/run-suite.ts unit --package @raceiq/tooling-build",
    "test:tooling": "bun ../../scripts/test/run-suite.ts tooling --package @raceiq/tooling-build"
  }
}
