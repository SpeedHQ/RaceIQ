{
  "name": "@raceiq/game-iracing",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ibt-preview": "./src/ibt-preview.ts",
    "./ibt-reader": "./src/ibt-reader.ts",
    "./identity": "./src/identity.ts",
    "./lap-detector": "./src/lap-detector.ts",
    "./normalizer": "./src/normalizer.ts",
    "./recorder": "./src/recorder.ts",
    "./source": "./src/source.ts",
    "./track-map-svg": "./src/track-map-svg.ts",
    "./track-map": "./src/track-map.ts",
    "./test-support/games/iracing-ibt": "./test/support/games/iracing-ibt.ts",
    "./test-support/recordings": "./test/support/recordings.ts",
    "./game-parser": "./src/game-parser.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "@raceiq/backend-core": "workspace:*",
    "@raceiq/capture-formats": "workspace:*",
    "@raceiq/shared": "workspace:*",
