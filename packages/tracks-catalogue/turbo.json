{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "!test/**"]
    },
    "e2e:impact": {
      "dependsOn": ["transit", "raceiq-e2e#e2e:catalogue-runtime:impact"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/client/src/features/tracks-catalogue-host.tsx",
        "$TURBO_ROOT$/client/src/routes/$gameid/tracks*.tsx"
      ]
    }
  }
}
