{
  "name": "@raceiq/sessions-page",
  "private": true,
  "type": "module",
  "exports": { "./ui": "./ui/index.ts", "./server": "./server/index.ts", "./contracts": "./contracts/index.ts" },
  "scripts": {
    "lint": "bun ../../client/node_modules/oxlint/bin/oxlint .",
    "typecheck": "bun check --project tsconfig.ui.json && bun check --project tsconfig.server.json",
    "test:boundaries": "bun ../../scripts/test/check-feature-boundaries.ts sessions-page",
    "e2e:impact": "bun ../../scripts/test/check-feature-boundaries.ts sessions-page",
    "test:unit": "bun ../../scripts/test/run-suite.ts unit --package @raceiq/sessions-page",
    "test:integration": "bun ../../scripts/test/run-suite.ts integration --package @raceiq/sessions-page",
    "test:e2e": "cd ../../playwright && E2E_SERVER_MODE=compiled PW_SERVER_SET=seeded PW_SEEDED_E2E_PORT=3166 PW_SEEDED_E2E_CLIENT_PORT=4166 PW_SEEDED_E2E_UDP_PORT=15366 PW_SEEDED_E2E_DATA_DIR=./test-results/test-data-sessions-page RACEIQ_FEATURE_F1_EXPERIMENTS=true RACEIQ_FEATURE_IRACING_ADAPTER=true bun ../scripts/playwright-ci.ts test --config=playwright.config.ts --project=sessions-page --output=test-results/sessions-page"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "lucide-react": "^1.47.0",
    "hono": "4.13.8",
    "@hono/zod-validator": "0.9.1",
    "zod": "^4.6.5",
    "@raceiq/shared": "workspace:*",
    "@raceiq/analysis-core": "workspace:*",
    "@raceiq/backend-core": "workspace:*",
    "@raceiq/game-catalogs": "workspace:*",
    "@raceiq/frontend-pure": "workspace:*",
    "@raceiq/game-acc": "workspace:*",
    "@raceiq/game-ac-evo": "workspace:*",
    "@raceiq/game-iracing": "workspace:*"
  },
  "devDependencies": { "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0", "@playwright/test": "1.62.1", "drizzle-orm": "^0.45.2", "@raceiq/game-fm-2023-metadata": "workspace:*" }
}
