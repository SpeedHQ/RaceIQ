{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!test/**"]
    },
    "test": {
      "dependsOn": ["transit", "client#i18n:compile"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/test/artifacts/carsetup/mustang.carsetup", "$TURBO_ROOT$/test/artifacts/carsetup/Tourist.carsetup", "$TURBO_ROOT$/test/artifacts/carsetup/Default-12312.carsetup", "$TURBO_ROOT$/apps/backend/test/support/setup-app.ts", "$TURBO_ROOT$/server/test-support/setup-data-dir.ts"]
    },
    "test:unit": { "dependsOn": ["transit", "client#i18n:compile"] },
    "test:tooling": {
      "dependsOn": ["transit", "client#i18n:compile"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/apps/backend/test/support/setup-app.ts", "$TURBO_ROOT$/server/test-support/setup-data-dir.ts"]
    },
    "test:integration": {
      "dependsOn": ["transit", "client#i18n:compile"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/test/artifacts/carsetup/mustang.carsetup", "$TURBO_ROOT$/test/artifacts/carsetup/Tourist.carsetup", "$TURBO_ROOT$/test/artifacts/carsetup/Default-12312.carsetup", "$TURBO_ROOT$/apps/backend/test/support/setup-app.ts", "$TURBO_ROOT$/server/test-support/setup-data-dir.ts"]
    },
    "test:e2e:recordings": {
      "dependsOn": ["transit", "client#i18n:compile"],
      "cache": false,
      "outputs": []
    }
  }
}
