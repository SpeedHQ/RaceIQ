{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["algorithm"],
  "tasks": {
    "transit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!test/**"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test/run-suite.ts",
        "$TURBO_ROOT$/scripts/test/check-shards.ts",
        "$TURBO_ROOT$/scripts/test/owners.ts",
        "$TURBO_ROOT$/scripts/test/setup-isolated-data-dir.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.env.development",
        "$TURBO_ROOT$/bunfig.integration.toml"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "transit"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "transit"
      ]
    }
  }
}
