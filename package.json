{
  "name": "raceiq",
  "private": true,
  "packageManager": "bun@1.4.4",
  "version": "0.24.0",
  "type": "module",
  "workspaces": [
    "client",
    "playwright",
    "shared",
    "server",
    "scripts",
    "apps/*",
    "packages/*",
    "packages/game-lmu/test"
  ],
  "scripts": {
    "dev": "bun scripts/dev/dev.ts",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('data', { recursive: true, force: true });\"",
    "dev:server": "bun --env-file=.env.development --watch run apps/backend/src/index.ts",
    "dev:proxy": "bun scripts/dev/dev-proxy.ts",
    "dev:dump:ac-evo": "bun run dev:proxy && bun scripts/dev/dump.ts ac-evo",
    "dev:dump:acc": "bun run dev:proxy && bun scripts/dev/dump.ts acc",
    "dev:dump:iracing": "bun run dev:proxy && bun scripts/dev/dump.ts iracing",
    "dev:dump:lmu": "bun run dev:proxy && bun scripts/dev/dump.ts lmu",
    "dev:dump:f1": "bun run dev:proxy && bun scripts/dev/dump.ts f1-2025",
    "dev:dump:fm": "bun run dev:proxy && bun scripts/dev/dump.ts fm-2023",
    "dev:client": "bun run dev:proxy && bun --env-file=.env.development scripts/dev/client.ts",
    "dev:dump:ams2": "bun run dev:proxy && bun scripts/dev/dump.ts ams2",
    "build": "bunx turbo run build",
    "start": "NODE_ENV=production ./dist/raceiq",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun apps/backend/scripts/data/seed-db.ts",
    "test:shards": "bun scripts/test/check-shards.ts",
    "test:unit": "bun scripts/test/run-turbo.ts test:unit --affected",
    "test:tooling": "bun scripts/test/run-turbo.ts test:tooling --affected",
    "test:integration": "bun scripts/test/run-turbo.ts test:integration --affected",
    "test": "bun scripts/test/run-all.ts",
    "test:all": "bun scripts/test/run-all.ts",
    "test:e2e:recordings": "bun scripts/test/run-turbo.ts test:e2e:recordings --affected --concurrency=1",
    "test:upgrade": "bun scripts/ci/upgrade-smoke.ts",
    "test:e2e:all": "bun run build:browser && bun run test:e2e:recordings && bun run test:e2e",
    "typecheck": "bunx turbo run typecheck --affected",
    "typecheck:storybook": "bun check --project client/tsconfig.stories.json",
    "typecheck:scripts": "bun check --project scripts/tsconfig.json",
    "lint": "bunx turbo run lint",
    "format": "cd client && bun run format",
    "i18n:machine-translate": "bunx @inlang/cli machine translate --project ./client/project.inlang",
    "i18n:check-keys": "bun scripts/i18n/check-message-keys.ts",
    "i18n:validate": "bunx @inlang/cli validate --project ./client/project.inlang",
    "test:ai": "bun test ./apps/backend/test/ai/evals/ai-quality.ai-eval.ts ./apps/backend/test/ai/evals/analyse-chat-tools.ai-eval.ts --timeout 120000",
    "ai:baseline": "bun apps/backend/scripts/quality/ai-baseline.ts",
    "bench": "bun apps/backend/test/benchmarks/pipeline.bench.ts",
    "bench:pipeline-stages": "bun apps/backend/test/benchmarks/pipeline-stages.bench.ts",
    "bench:recorder": "bun apps/backend/test/benchmarks/recorder.bench.ts",
    "bench:direct-compare": "bun apps/backend/test/benchmarks/direct-recorder-compare.ts",
    "tracks:segments": "bun packages/tooling-data/src/tracks/generate-track-segments.ts",
    "tracks:coverage": "bun packages/tooling-data/src/tracks/track-coverage.ts",
    "telemetry:sector-ordinal-map": "bun packages/telemetry-core/scripts/generate-sector-ordinal-map.ts",
    "telemetry:sector-ordinal-map:check": "bun packages/telemetry-core/scripts/generate-sector-ordinal-map.ts --check",
    "laps:export": "bun apps/backend/scripts/data/export-laps.ts",
    "laps:import": "bun apps/backend/scripts/data/import-laps.ts",
    "ibt:probe": "bun packages/tooling-data/src/iracing/probe-ibt.ts",
    "telemetry:catalog": "bun packages/tooling-catalog/src/catalog/generate-telemetry-catalog.ts",
    "telemetry:catalog:check": "bun packages/tooling-catalog/src/catalog/generate-telemetry-catalog.ts --check --repeat",
    "iracing:cars:seed": "bun packages/tooling-data/src/iracing/seed-cars.ts",
    "iracing:car-classes:seed": "bun packages/tooling-data/src/iracing/seed-car-classes.ts",
    "iracing:tracks:seed": "bun packages/tooling-data/src/iracing/seed-tracks.ts",
    "iracing:track-maps:seed": "bun packages/tooling-data/src/iracing/seed-track-maps.ts",
    "gzip:recording": "bun packages/tooling-data/src/telemetry/recordings/gzip-recording.ts",
    "fixtures:iracing": "bun packages/tooling-data/src/iracing/generate-recording-fixture.ts",
    "fixtures:iracing:seed": "bun packages/tooling-data/src/iracing/generate-seed-fixture.ts",
    "build:installer": "bun packages/tooling-build/src/build/build-installer.ts",
    "mastra:studio": "portless studio bun scripts/dev/mastra-studio.ts",
    "mastra:migrate": "DATA_DIR=\"$PWD/data\" bunx --bun mastra migrate --dir apps/backend/src/mastra",
    "postinstall": "lefthook install",
    "effect:check": "effect-tsgo diagnostics --project server/tsconfig.json",
    "build:browser": "bun scripts/build-browser.ts",
    "record:demo": "bun run build:browser && E2E_SERVER_MODE=compiled PW_SERVER_SET=seeded DEMO_START_FRAME=28% DEMO_MAX_FRAMES=2700 bunx playwright test --config=playwright/playwright.config.ts --project=record-demo",
    "screenshots": "bun scripts/run-browser-verification.ts screenshots",
    "test:e2e": "bun scripts/run-browser-verification.ts e2e",
    "test:e2e:fresh": "bun scripts/run-browser-verification.ts fresh",
    "test:e2e:tunes": "bun scripts/run-browser-verification.ts tunes",
    "test:e2e:seeded": "bun scripts/run-browser-verification.ts seeded",
    "test:e2e:compiled": "bun run test:e2e",
    "ui:diff": "bun packages/tooling-ui/src/ui/local-ui-diff.ts",
    "ui:diff:storybook": "bun packages/tooling-ui/src/ui/local-ui-diff.ts --storybook-only",
    "render:demo": "ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libx264 -pix_fmt yuv420p -crf 30 assets/demo-render.mp4 && ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libvpx-vp9 -crf 32 -b:v 0 assets/demo-render.webm",
    "lighthouse": "lighthouse http://raceiq.localhost:1355/ --only-categories=accessibility,performance,best-practices --chrome-flags=\"--headless=new --no-sandbox --disable-gpu\" --output=html --output-path=./lighthouse-report.html && echo 'Report: lighthouse-report.html'",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "desktop:build": "bun scripts/desktop/build.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.126",
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/provider-utils": "^5.0.83",
    "@duckdb/node-api": "2.0.1-r.1",
    "@hono/zod-validator": "0.9.1",
    "@libsql/client": "^0.18.0",
    "@libsql/win32-x64-msvc": "^0.5.29",
    "@mastra/ai-sdk": "^1.12.1",
    "@mastra/core": "^1.86.0",
    "@mastra/evals": "^1.10.12",
    "@mastra/libsql": "^1.32.0",
    "@mastra/memory": "^1.41.3",
    "ai": "7.0.181",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "4.13.22",
    "libsql": "^0.5.29",
    "mitata": "^1.0.34",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@effect/tsgo": "0.73.4",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@mastra/duckdb": "^1.19.2",
    "@mastra/hono": "^1.7.28",
    "@mastra/loggers": "^1.3.12",
    "@mastra/observability": "^1.24.3",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@types/bun": "^1.4.5",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.3",
    "lighthouse": "^13.6.0",
    "meshoptimizer": "1.3.0",
    "pixelmatch": "^8.0.0",
    "portless": "^0.18.1",
    "turbo": "2.11.13",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "^0.5.29"
  }
}
