{
  "name": "raceiq",
  "version": "0.13.0",
  "type": "module",
  "workspaces": [
    "client",
    "playwright"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.development scripts/dev.ts",
    "dev:server": "bun --env-file=.env.development --watch run server/index.ts",
    "dev:proxy": "bun scripts/dev-proxy.ts",
    "dev:dump:ac-evo": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run server/index.ts --record=ac-evo\" \"cd client && portless raceiq bun run dev\"",
    "dev:dump:acc": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run server/index.ts --record=acc\" \"cd client && portless raceiq bun run dev\"",
    "dev:dump:iracing": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run server/index.ts --record=iracing\" \"cd client && portless raceiq bun run dev\"",
    "dev:dump:f1": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run server/index.ts --record=f1-2025\" \"cd client && portless raceiq bun run dev\"",
    "dev:dump:fm": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run server/index.ts --record=fm-2023\" \"cd client && portless raceiq bun run dev\"",
    "dev:client": "bun run dev:proxy && cd client && portless raceiq bun run dev",
    "build": "bun --env-file=.env.production scripts/build.ts",
    "start": "NODE_ENV=production ./dist/raceiq",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun scripts/seed-db.ts",
    "test": "DATA_DIR=\"$PWD/.data-test\" bun test --timeout 30000",
    "lint": "cd client && bun run lint",
    "format": "cd client && bun run format",
    "i18n:machine-translate": "bunx @inlang/cli machine translate --project ./client/project.inlang",
    "i18n:validate": "bunx @inlang/cli validate --project ./client/project.inlang",
    "test:ai": "bun test test/ai-quality.ai-eval.ts --timeout 120000",
    "ai:baseline": "bun scripts/ai-baseline.ts",
    "bench": "bun test/benchmarks/pipeline.bench.ts",
    "extract:tracks": "bun scripts/extract-fm2023-tracks.ts && bun scripts/extract-f1-tracks.ts",
    "extract:tracks:forza": "bun scripts/extract-fm2023-tracks.ts",
    "extract:tracks:f1": "bun scripts/extract-f1-25-tracks.ts",
    "extract:tracks:acc": "bun scripts/extract-acc-tracks.ts",
    "extract:ac-evo": "bun scripts/extract-ac-evo-tracks.ts && bun scripts/extract-ac-evo-cars.ts",
    "extract:tracks:ac-evo": "bun scripts/extract-ac-evo-tracks.ts",
    "tracks:segments": "bun scripts/generate-track-segments.ts",
    "tracks:coverage": "bun scripts/track-coverage.ts",
    "extract:cars:ac-evo": "bun scripts/extract-ac-evo-cars.ts",
    "scrape:car-images:ac-evo": "bun scripts/scrape-ac-evo-car-images.ts",
    "laps:export": "bun scripts/export-laps.ts",
    "laps:import": "bun scripts/import-laps.ts",
    "ibt:probe": "bun scripts/probe-ibt.ts",
    "telemetry:catalog": "bun scripts/generate-telemetry-catalog.ts",
    "telemetry:catalog:check": "bun scripts/generate-telemetry-catalog.ts --check --repeat",
    "iracing:cars:seed": "bun scripts/seed-iracing-cars.ts",
    "iracing:tracks:seed": "bun scripts/seed-iracing-tracks.ts",
    "gzip:recording": "bun scripts/gzip-recording.ts",
    "fixtures:iracing": "bun scripts/generate-iracing-recording-fixture.ts",
    "build:installer": "bun scripts/build-installer.ts",
    "mastra:studio": "portless studio bun scripts/mastra-studio.ts",
    "mastra:migrate": "DATA_DIR=\"$PWD/data\" bunx --bun mastra migrate --dir mastra",
    "postinstall": "lefthook install",
    "record:demo": "cd playwright && DEMO_START_FRAME=28% DEMO_MAX_FRAMES=2700 bunx playwright test --project=record-demo",
    "test:screenshots": "cd playwright && E2E_SERVER_MODE=dev PW_SCREENSHOT_ONLY=1 PW_SEED_SCREENSHOTS=1 bunx playwright test --project=mobile-screenshots",
    "ui:diff": "bun scripts/local-ui-diff.ts",
    "render:demo": "ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libx264 -pix_fmt yuv420p -crf 30 assets/demo-render.mp4 && ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libvpx-vp9 -crf 32 -b:v 0 assets/demo-render.webm",
    "lighthouse": "lighthouse http://raceiq.localhost:1355/ --only-categories=accessibility,performance,best-practices --chrome-flags=\"--headless=new --no-sandbox --disable-gpu\" --output=html --output-path=./lighthouse-report.html && echo 'Report: lighthouse-report.html'"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.20",
    "@ai-sdk/openai": "4.0.20",
    "@ai-sdk/provider-utils": "5.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@libsql/win32-x64-msvc": "^0.5.29",
    "@mastra/ai-sdk": "1.6.3",
    "@mastra/core": "1.52.1",
    "@mastra/evals": "1.6.0",
    "@mastra/libsql": "1.17.0",
    "@mastra/memory": "1.23.1",
    "ai": "7.0.37",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "hono": "^4.12.33",
    "libsql": "^0.5.29",
    "mitata": "^1.0.34",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@mastra/duckdb": "^1.5.2",
    "@mastra/hono": "^1.5.12",
    "@mastra/loggers": "^1.2.0",
    "@mastra/observability": "^1.16.3",
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "lighthouse": "^13.4.1",
    "pixelmatch": "^7.2.0",
    "portless": "^0.15.5"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "^0.5.29"
  },
  "patchedDependencies": {
    "@inlang/paraglide-js@2.22.0": "patches/@inlang%2Fparaglide-js@2.22.0.patch"
  }
}
