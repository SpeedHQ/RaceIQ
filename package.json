{
  "name": "raceiq",
  "private": true,
  "packageManager": "bun@1.4.2",
  "version": "0.19.2",
  "type": "module",
  "workspaces": [
    "client",
    "playwright",
    "shared",
    "server",
    "scripts",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev/dev.ts",
    "dev:server": "bun --env-file=.env.development --watch run apps/backend/src/index.ts",
    "dev:proxy": "bun scripts/dev/dev-proxy.ts",
    "dev:dump:ac-evo": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=ac-evo\" \"bun scripts/dev/client.ts\"",
    "dev:dump:acc": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=acc\" \"bun scripts/dev/client.ts\"",
    "dev:dump:iracing": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=iracing\" \"bun scripts/dev/client.ts\"",
    "dev:dump:lmu": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=lmu\" \"bun scripts/dev/client.ts\"",
    "dev:dump:f1": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=f1-2025\" \"bun scripts/dev/client.ts\"",
    "dev:dump:fm": "bun run dev:proxy && concurrently \"bun --env-file=.env.development --watch run apps/backend/src/index.ts --record=fm-2023\" \"bun scripts/dev/client.ts\"",
    "dev:client": "bun run dev:proxy && bun scripts/dev/client.ts",
    "build": "bunx turbo run build",
    "start": "NODE_ENV=production ./dist/raceiq",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun apps/backend/scripts/data/seed-db.ts",
    "test:shards": "bun scripts/test/check-shards.ts",
    "test:unit": "bun scripts/test/run-turbo.ts test:unit",
    "test:tooling": "bun scripts/test/run-turbo.ts test:tooling",
    "test:integration": "bun scripts/test/run-turbo.ts test:integration",
    "test": "bun scripts/test/run-turbo.ts test:unit test:tooling test:integration",
    "test:e2e:recordings": "bun scripts/test/run-turbo.ts test:e2e:recordings",
    "test:all": "bun scripts/test/run-all.ts",
    "test:e2e:all": "bun run test:e2e:recordings && bunx turbo run test --filter=raceiq-e2e",
    "typecheck": "bun run --cwd client i18n:compile && bunx tsc --build client/tsconfig.json --pretty false && bun run typecheck:storybook && bun run --sequential --filter '@raceiq/*' typecheck",
    "typecheck:storybook": "bunx tsc --project client/tsconfig.stories.json --noEmit",
    "typecheck:scripts": "bunx tsc --project scripts/tsconfig.json",
    "lint": "bunx turbo run lint",
    "format": "cd client && bun run format",
    "i18n:machine-translate": "bunx @inlang/cli machine translate --project ./client/project.inlang",
    "i18n:check-keys": "bun scripts/i18n/check-message-keys.ts",
    "i18n:validate": "bunx @inlang/cli validate --project ./client/project.inlang",
    "test:ai": "bun test ./apps/backend/test/ai/evals/ai-quality.ai-eval.ts --timeout 120000",
    "ai:baseline": "bun apps/backend/scripts/quality/ai-baseline.ts",
    "bench": "bun apps/backend/test/benchmarks/pipeline.bench.ts",
    "tracks:segments": "bun packages/tooling-data/src/tracks/generate-track-segments.ts",
    "tracks:coverage": "bun packages/tooling-data/src/tracks/track-coverage.ts",
    "laps:export": "bun apps/backend/scripts/data/export-laps.ts",
    "laps:import": "bun apps/backend/scripts/data/import-laps.ts",
    "ibt:probe": "bun packages/tooling-data/src/iracing/probe-ibt.ts",
    "telemetry:catalog": "bun packages/tooling-catalog/src/catalog/generate-telemetry-catalog.ts",
    "telemetry:catalog:check": "bun packages/tooling-catalog/src/catalog/generate-telemetry-catalog.ts --check --repeat",
    "iracing:cars:seed": "bun packages/tooling-data/src/iracing/seed-cars.ts",
    "iracing:tracks:seed": "bun packages/tooling-data/src/iracing/seed-tracks.ts",
    "gzip:recording": "bun packages/tooling-data/src/telemetry/recordings/gzip-recording.ts",
    "fixtures:iracing": "bun packages/tooling-data/src/iracing/generate-recording-fixture.ts",
    "fixtures:iracing:seed": "bun packages/tooling-data/src/iracing/generate-seed-fixture.ts",
    "build:installer": "bun packages/tooling-build/src/build/build-installer.ts",
    "mastra:studio": "portless studio bun scripts/dev/mastra-studio.ts",
    "mastra:migrate": "DATA_DIR=\"$PWD/data\" bunx --bun mastra migrate --dir apps/backend/src/mastra",
    "postinstall": "lefthook install",
    "record:demo": "cd playwright && PW_SERVER_SET=fresh DEMO_START_FRAME=28% DEMO_MAX_FRAMES=2700 bunx playwright test --project=record-demo",
    "screenshots": "cd playwright && E2E_SERVER_MODE=dev PW_SERVER_SET=seeded PW_SCREENSHOT_ONLY=1 PW_SEED_SCREENSHOTS=1 bunx turbo run test --filter=raceiq-e2e -- --project=mobile-screenshots",
    "test:e2e": "PW_SERVER_SET=all bunx turbo run test --filter=raceiq-e2e -- --workers=1 --project=fresh-install --project=tunes --project=tunes-unseeded --project=seeded-e2e --project=seeded-routes --project=seeded-imports --project=seeded-capture-migration --project=mobile-device --project=tablet-device",
    "test:e2e:fresh": "PW_SERVER_SET=fresh bunx turbo run test --filter=raceiq-e2e -- --project=fresh-install --max-failures=1",
    "test:e2e:tunes": "PW_SERVER_SET=tunes bunx turbo run test --filter=raceiq-e2e -- --project=tunes --max-failures=1",
    "test:e2e:seeded": "PW_SERVER_SET=seeded bunx turbo run test --filter=raceiq-e2e -- --project=seeded-e2e --max-failures=1",
    "test:e2e:compiled": "E2E_SERVER_MODE=compiled PW_SERVER_SET=all bun run test:e2e",
    "ui:diff": "bun packages/tooling-ui/src/ui/local-ui-diff.ts",
    "ui:diff:storybook": "bun packages/tooling-ui/src/ui/local-ui-diff.ts --storybook-only",
    "render:demo": "ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libx264 -pix_fmt yuv420p -crf 30 assets/demo-render.mp4 && ffmpeg -y -framerate 60 -i /tmp/raceiq-demo-frames/frame-%06d.jpg -vf scale=1280:720 -c:v libvpx-vp9 -crf 32 -b:v 0 assets/demo-render.webm",
    "lighthouse": "lighthouse http://raceiq.localhost:1355/ --only-categories=accessibility,performance,best-practices --chrome-flags=\"--headless=new --no-sandbox --disable-gpu\" --output=html --output-path=./lighthouse-report.html && echo 'Report: lighthouse-report.html'"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.74",
    "@ai-sdk/openai": "^4.0.69",
    "@ai-sdk/provider-utils": "^5.0.43",
    "@duckdb/node-api": "1.5.2-r.2",
    "@hono/zod-validator": "0.9.1",
    "@libsql/client": "^0.18.0",
    "@libsql/win32-x64-msvc": "^0.5.29",
    "@mastra/ai-sdk": "^1.10.3",
    "@mastra/core": "^1.67.0",
    "@mastra/evals": "^1.10.2",
    "@mastra/libsql": "^1.23.0",
    "@mastra/memory": "^1.30.0",
    "ai": "7.0.105",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "4.13.8",
    "libsql": "^0.5.29",
    "mitata": "^1.0.34",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@mastra/duckdb": "^1.9.0",
    "@mastra/hono": "^1.7.9",
    "@mastra/loggers": "^1.3.2",
    "@mastra/observability": "^1.17.8",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "^0.1.5",
    "@types/bun": "^1.4.2",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.14",
    "lighthouse": "^13.4.1",
    "meshoptimizer": "1.2.0",
    "pixelmatch": "^7.2.0",
    "portless": "^0.15.6",
    "typescript": "^7.0.2",
    "turbo": "2.11.7"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "^0.5.29"
  }
}
