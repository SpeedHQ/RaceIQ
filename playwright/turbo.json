{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["@raceiq/tooling-build#build"],
      "env": ["NODE_ENV", "RACEIQ_*", "BUN_TEST_WORKERS", "E2E_SERVER_MODE", "PW_*"]
    },
    "e2e:catalogue-runtime:impact": {
      "inputs": [
        "config/**",
        "support/**",
        "tests/support/**",
        "tests/setup/**",
        "playwright.config.ts",
        "$TURBO_ROOT$/scripts/test/check-feature-boundaries.ts",
        "$TURBO_ROOT$/packages/tooling-data/src/data/**",
        "$TURBO_ROOT$/apps/backend/scripts/data/**",
        "$TURBO_ROOT$/packages/tooling-build/**",
        "$TURBO_ROOT$/test/artifacts/**",
        "$TURBO_ROOT$/client/src/routes/{__root,$gameid,ac-evo,acc,ams2,f125,fm23,iracing,lmu,login,onboarding}.tsx",
        "$TURBO_ROOT$/client/src/features/{lap-replay,session-analyse,sessions-page}-host.tsx",
        "$TURBO_ROOT$/client/src/components/*",
        "$TURBO_ROOT$/client/src/components/{acc,ai,ai-chat,analyse,assistant-ui,comparison,dev,driver,f1,forza,import,live-track,lmu,onboarding,race-results,security,settings,setup-tune,shadcn-studio,streaming,telemetry,ui,wireframe}/**",
        "$TURBO_ROOT$/client/src/components/tunes/{SectorDetailView,SectorMap,SectorRangeBreakdown,SetupSections,track-map-geometry}.*",
        "$TURBO_ROOT$/client/src/components/tunes/{review,track-focus}/**",
        "$TURBO_ROOT$/client/src/data/car-models.ts",
        "$TURBO_ROOT$/client/src/hooks/**",
        "$TURBO_ROOT$/client/src/lib/**",
        "$TURBO_ROOT$/client/src/stores/**",
        "$TURBO_ROOT$/client/src/styles/**",
        "$TURBO_ROOT$/client/src/index.css",
        "$TURBO_ROOT$/client/src/main.tsx",
        "$TURBO_ROOT$/client/index.html",
        "$TURBO_ROOT$/client/messages/**",
        "$TURBO_ROOT$/client/public/**",
        "$TURBO_ROOT$/client/package.json",
        "$TURBO_ROOT$/client/vite.config.ts",
        "$TURBO_ROOT$/apps/backend/src/**",
        "$TURBO_ROOT$/apps/backend/package.json",
        "$TURBO_ROOT$/scripts/playwright-ci.ts",
        "$TURBO_ROOT$/scripts/run-browser-verification.ts",
        "$TURBO_ROOT$/scripts/build-browser.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "browser:runtime:impact": {
      "dependsOn": ["client#transit", "@raceiq/backend#transit"],
      "inputs": ["config/**", "support/server/**", "playwright.config.ts", "tsconfig.json", "tests/support/**", "$TURBO_ROOT$/scripts/playwright-ci.ts", "$TURBO_ROOT$/packages/tooling-build/src/build/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "browser:seed:impact": {
      "dependsOn": ["browser:runtime:impact"],
      "inputs": ["tests/setup/**", "$TURBO_ROOT$/packages/tooling-data/src/data/**", "$TURBO_ROOT$/apps/backend/scripts/data/**", "$TURBO_ROOT$/test/artifacts/**"]
    },
    "browser:fresh:impact": {
      "dependsOn": ["browser:runtime:impact"],
      "inputs": ["tests/fresh-install/**", "$TURBO_ROOT$/packages/tooling-data/src/data/seed-db-options.ts"]
    },
    "browser:tunes:impact": {
      "dependsOn": ["browser:seed:impact"],
      "inputs": ["tests/tunes/**"]
    },
    "browser:tunes-unseeded:impact": {
      "dependsOn": ["browser:runtime:impact"],
      "inputs": ["tests/tunes/ac-evo.spec.ts", "tests/tunes/acc.spec.ts", "tests/tunes/support/**", "$TURBO_ROOT$/packages/tooling-data/src/data/seed-db-options.ts"]
    },
    "browser:seeded-e2e:impact": {
      "dependsOn": ["browser:seed:impact"],
      "inputs": ["tests/seeded/**", "!tests/seeded/routes/**/*.spec.ts", "!tests/seeded/analyse/core-flow.spec.ts", "!tests/seeded/dev-tools/server-import.spec.ts", "!tests/seeded/settings/storage.spec.ts"]
    },
    "browser:seeded-routes:impact": {
      "dependsOn": ["browser:seed:impact"],
      "inputs": ["tests/seeded/routes/**"]
    },
    "browser:seeded-imports:impact": {
      "dependsOn": [
        "e2e:catalogue-runtime:impact",
        "@raceiq/game-lmu#transit",
        "@raceiq/lap-replay#transit",
        "@raceiq/session-analyse#transit",
        "@raceiq/tooling-data#transit"
      ],
      "inputs": [
        "tests/seeded/analyse/{core-flow.spec,controls,fixtures}.ts",
        "tests/seeded/dev-tools/{server-import.spec,helpers}.ts",
        "tests/seeded/settings/storage.spec.ts",
        "$TURBO_ROOT$/packages/game-lmu/test/e2e/browser/**",
        "$TURBO_ROOT$/packages/game-lmu/test/support/**",
        "$TURBO_ROOT$/packages/game-lmu/test/fixtures/sessions/**",
        "$TURBO_ROOT$/packages/sessions-page/{contracts,server,ui}/**",
        "$TURBO_ROOT$/client/src/components/home/**",
        "$TURBO_ROOT$/client/src/routes/{dev,index}.tsx",
        "$TURBO_ROOT$/client/src/routes/$gameid/{compare,sessions,sessions.*,tracks,tracks.*}.tsx",
        "$TURBO_ROOT$/client/src/routes/$gameid/sessions/**"
      ]
    },
    "browser:webgpu:impact": {
      "dependsOn": ["browser:seed:impact", "@raceiq/lap-replay#transit"],
      "inputs": ["$TURBO_ROOT$/packages/lap-replay/test/e2e/compare/spectate-native-camera.spec.ts", "$TURBO_ROOT$/packages/lap-replay/test/e2e/compare/spectate-transition.spec.ts", "$TURBO_ROOT$/packages/lap-replay/test/e2e/support/**"]
    },
    "visual:responsive:impact": {
      "dependsOn": ["browser:seed:impact"],
      "inputs": ["responsive-screenshots.config.ts", "tests/responsive/**", "$TURBO_ROOT$/scripts/ci/workflow-ops.ts", "$TURBO_ROOT$/scripts/run-browser-verification.ts"]
    },
    "visual:storybook:impact": {
      "dependsOn": ["client#transit", "@raceiq/tooling-ui#transit"],
      "inputs": ["$TURBO_ROOT$/client/.storybook/**", "$TURBO_ROOT$/client/src/stories/**", "$TURBO_ROOT$/client/playwright.config.ts", "$TURBO_ROOT$/client/tsconfig.stories.json", "$TURBO_ROOT$/packages/tooling-ui/src/ui/**"]
    },
    "verify:build:impact": {
      "dependsOn": ["client#transit", "@raceiq/backend#transit", "@raceiq/tooling-build#transit"],
      "inputs": ["$TURBO_ROOT$/server/**", "!$TURBO_ROOT$/server/test-support/**", "$TURBO_ROOT$/shared/**", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "verify:desktop:impact": {
      "dependsOn": ["verify:build:impact"],
      "inputs": ["$TURBO_ROOT$/apps/desktop/**", "$TURBO_ROOT$/scripts/desktop/**", "$TURBO_ROOT$/scripts/build-browser.ts"]
    },
    "ci:check-shards": {
      "inputs": ["$TURBO_ROOT$/**/*.test.ts", "$TURBO_ROOT$/**/*.test.tsx", "$TURBO_ROOT$/**/test/*-files.txt", "$TURBO_ROOT$/**/package.json", "$TURBO_ROOT$/scripts/test/check-shards.ts", "$TURBO_ROOT$/scripts/test/owners.ts"]
    },
    "ci:check-locales": {
      "inputs": ["$TURBO_ROOT$/client/messages/*.json", "$TURBO_ROOT$/client/project.inlang/settings.json", "$TURBO_ROOT$/scripts/i18n/check-message-keys.ts"]
    },
    "ci:check-db-upgrade": {
      "inputs": ["$TURBO_ROOT$/scripts/ci/check-db-upgrade.ts", "$TURBO_ROOT$/apps/backend/test/db/**", "$TURBO_ROOT$/apps/backend/src/db/**", "$TURBO_ROOT$/server/db/migrations.ts", "$TURBO_ROOT$/packages/tooling-data/src/data/**"]
    },
    "ci:check-telemetry": {
      "dependsOn": ["@raceiq/tooling-catalog#transit"],
      "inputs": ["$TURBO_ROOT$/scripts/ci/check-telemetry-catalog.ts", "$TURBO_ROOT$/shared/telemetry/**", "$TURBO_ROOT$/shared/telemetry-catalog.generated.json"]
    }
  }
}
