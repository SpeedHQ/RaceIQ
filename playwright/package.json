{
  "name": "raceiq-e2e",
  "private": true,
  "exports": {
    "./test-support/browser-errors": "./tests/support/browser-errors.ts"
  },
  "scripts": {
    "lint": "node ../client/node_modules/oxlint/bin/oxlint .",
    "test": "playwright test --workers=1",
    "ci:browser": "bun ../scripts/playwright-ci.ts test",
    "ci:responsive-current": "cd .. && bun scripts/ci/workflow-ops.ts screenshot-current",
    "ci:responsive-base": "cd .. && bun scripts/ci/workflow-ops.ts screenshot-base",
    "ci:storybook-base": "cd ../client && bunx playwright test --update-snapshots --reporter=line --grep-invert 'covered stories render without API requests'",
    "ci:storybook-current": "cd ../client && bunx playwright test --update-snapshots --reporter=line",
    "ci:check-shards": "cd .. && bun run test:shards",
    "ci:check-locales": "cd .. && bun run i18n:check-keys",
    "ci:check-db-upgrade": "cd .. && bun scripts/ci/check-db-upgrade.ts",
    "ci:check-telemetry": "cd .. && bun scripts/ci/check-telemetry-catalog.ts",
    "test:ui": "bunx turbo run test --filter=raceiq-e2e -- --ui",
    "screenshots": "playwright test --config=marketing-screenshots.config.ts",
    "screenshots:mobile": "bun ../scripts/run-browser-verification.ts screenshots",
    "test:tooling": "bun ../scripts/test/run-suite.ts tooling --package raceiq-e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@raceiq/tooling": "workspace:*",
    "@raceiq/backend-core": "workspace:*",
    "@raceiq/game-lmu": "workspace:*",
    "@raceiq/lap-replay": "workspace:*",
    "@raceiq/shared": "workspace:*"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "sharp": "^0.35.4",
    "libsql": "^0.5.29",
    "zod": "^4.6.5",
    "@raceiq/tooling-data": "workspace:*",
    "@raceiq/analysis-core": "workspace:*"
  }
}
