{
  "name": "raceiq-e2e",
  "private": true,
  "scripts": {
    "build": "cd .. && bun run build",
    "test": "bun run build && playwright test --workers=1",
    "test:ui": "bun run build && playwright test --workers=1 --ui",
    "screenshots": "playwright test --project=marketing",
    "screenshots:mobile": "bun run build && playwright test --project=mobile-screenshots",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test:tooling": "bun ../scripts/test/run-suite.ts tooling --package raceiq-e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@raceiq/tooling": "workspace:*",
    "@raceiq/backend-core": "workspace:*",
    "@raceiq/shared": "workspace:*"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "zod": "^4.6.5",
    "@raceiq/tooling-data": "workspace:*",
    "@raceiq/analysis-core": "workspace:*"
  }
}
