{
  "name": "raceiq-e2e",
  "private": true,
  "scripts": {
    "build": "cd .. && bun run build",
    "test": "bun run build && playwright test",
    "test:ui": "bun run build && playwright test --ui",
    "screenshots": "playwright test --project=marketing",
    "screenshots:mobile": "bun run build && playwright test --project=mobile-screenshots",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
