{
  "name": "client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test ./test",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure message-modules --strategy localStorage baseLocale --emit-ts-declarations",
    "build": "vite build && tsc -b",
    "lint": "oxlint .",
    "lint:root": "cd .. && oxlint .",
    "format": "oxfmt --write .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "snapshot:test": "playwright test --update-snapshots",
    "snapshot:test:docker": "bun ../scripts/ui/run-snapshot-in-docker.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.108",
