{
  "name": "client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure locale-modules",
    "i18n:compile:prod": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure message-modules",
    "build": "bun run i18n:compile:prod && tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "snapshot": "playwright test --update-snapshots && bun scripts/copy-snapshots.ts",
    "snapshot:test": "playwright test",
    "snapshot:docker": "bash ../scripts/snapshot-in-docker.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.45",
    "@assistant-ui/react": "^0.15.1",
    "@assistant-ui/react-ai-sdk": "^1.4.2",
    "@assistant-ui/react-markdown": "^0.14.8",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^2.23.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-vite-plugin": "^1.167.23",
    "ai": "^7.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "uplot": "^1.6.32",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "latest",
    "@storybook/test-runner": "^0.24.4",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "storybook": "latest",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
