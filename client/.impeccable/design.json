{
  "schemaVersion": 2,
  "name": "RaceIQ",
  "extensions": {
    "colorMeta": {
      "app-accent": { "hover": "var(--app-accent-hover)", "emphasis": "var(--app-highlight)" },
      "surfaceRamp": ["var(--app-bg)", "var(--app-surface)", "var(--app-surface-alt)"],
      "interactionColors": {
        "surfaceHover": "var(--app-surface-hover)",
        "borderHover": "var(--app-border-hover)",
        "filledText": "var(--app-on-filled)"
      },
      "utilitySurfaces": {
        "dropdown": "var(--app-dropdown)",
        "progressTrack": "var(--app-progress-track)"
      },
      "textRamp": ["var(--app-text)", "var(--app-text-secondary)", "var(--app-text-muted)", "var(--app-text-dim)"],
      "statusPalette": {
        "success": "var(--status-success)",
        "warning": "var(--status-warning)",
        "danger": "var(--status-danger)",
        "info": "var(--status-info)",
        "unavailable": "var(--status-unavailable)"
      },
      "statusInteractions": {
        "successHover": "var(--status-success-hover)",
        "dangerHover": "var(--status-danger-hover)"
      },
      "severityRamp": {
        "nominal": "var(--severity-nominal)",
        "caution": "var(--severity-caution)",
        "warning": "var(--severity-warning)",
        "critical": "var(--severity-critical)"
      },
      "operatingCold": "var(--operating-cold)"
    },
    "typographyMeta": {
      "fontFamily": "Geist Variable, sans-serif",
      "scale": {
        "title": "1.125rem",
        "heading": "1rem",
        "body": "0.9375rem",
        "subtext": "0.875rem",
        "label": "0.75rem",
        "unit": "0.6875rem"
      }
    },
    "shadows": {
      "policy": "none",
      "note": "Flat elevation by design; depth uses tonal surface stepping only"
    },
    "interactionMeta": {
      "activePress": "translate-y-px",
      "focusRing": "focus-visible:ring-3 focus-visible:ring-ring/50"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    }
  },
  "components": [
    {
      "name": "button-app-primary",
      "html": "<button class=\"ds-btn ds-btn-primary\">Analyze Lap</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border-radius:8px;font-family:'Geist Variable',sans-serif;font-size:0.8rem;font-weight:500;white-space:nowrap;transition:all 150ms;border:1px solid transparent;padding:6px 10px;}.ds-btn:active{transform:translateY(1px);}.ds-btn-primary{background:var(--app-accent);color:var(--app-on-filled);}.ds-btn-primary:hover{background:var(--app-accent-hover);}.ds-btn-primary:disabled{background:color-mix(in srgb,var(--app-accent) 40%,transparent);opacity:1;pointer-events:none;}"
    },
    {
      "name": "button-app-outline",
      "html": "<button class=\"ds-btn ds-btn-outline\">Cancel</button>",
      "css": ".ds-btn-outline{background:transparent;color:var(--app-text-secondary);border-color:var(--app-border-input);}.ds-btn-outline:hover{color:var(--app-text);border-color:var(--app-border-hover);}"
    },
    {
      "name": "button-app-ghost",
      "html": "<button class=\"ds-btn ds-btn-ghost\">Dismiss</button>",
      "css": ".ds-btn-ghost{background:transparent;color:var(--app-text-secondary);border-color:transparent;}.ds-btn-ghost:hover{color:var(--app-text);}"
    },
    {
      "name": "button-app-danger",
      "html": "<button class=\"ds-btn ds-btn-danger\">Delete Session</button>",
      "css": ".ds-btn-danger{background:var(--status-danger);color:var(--app-on-filled);}.ds-btn-danger:hover{background:color-mix(in srgb,var(--status-danger) 85%,var(--app-text));}"
    },
    {
      "name": "card",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-header\">Sector Times</div><div class=\"ds-card-body\">Corner-by-corner breakdown</div></div>",
      "css": ".ds-card{background:var(--app-surface);border:1px solid var(--app-border);border-radius:8px;}.ds-card:hover{background:var(--app-surface-hover);}.ds-card-header{font-family:'Geist Variable',sans-serif;font-size:1rem;font-weight:600;color:var(--app-text);padding:12px 16px;border-bottom:1px solid var(--app-border);}.ds-card-body{font-family:'Geist Variable',sans-serif;font-size:0.875rem;color:var(--app-text-secondary);padding:12px 16px;}"
    },
    {
      "name": "input",
      "html": "<input class=\"ds-input\" placeholder=\"Search laps\" />",
      "css": ".ds-input{background:var(--app-surface-alt);border:1px solid var(--app-border-input);border-radius:8px;color:var(--app-text);font-family:'Geist Variable',sans-serif;font-size:0.875rem;padding:6px 10px;}.ds-input:focus{outline:none;border-color:var(--app-accent);}.ds-input::placeholder{color:var(--app-text-dim);}"
    }
  ],
  "narrative": {
    "northStar": "The Cockpit Display",
    "overview": "RaceIQ reads like an instrument panel, not a startup dashboard. Near-black surfaces hold data at rest; a single cyan accent marks what's live, active, or actionable. Depth comes from tonal stepping between surface levels, never from drop shadows.",
    "keyCharacteristics": [
      "Near-black base with a single cyan signal color, not a rainbow of accents",
      "Flat, tonally-layered surfaces — no shadows, no glass",
      "A semantic severity scale reserved for telemetry state encoding, never used for UI chrome",
      "Compact, utilitarian type scale (11px-18px) built for data density",
      "Tactile, confident interactive states: visible hover shifts, no timid opacity fades"
    ],
    "rules": [
      "The One Signal Rule: cyan is the only interface accent; telemetry severity colors never leak into chrome",
      "The Compact Scale Rule: never introduce a type size above 18px outside a genuine new page-level heading need",
      "The Flat-By-Default Rule: no drop shadows, no glassmorphism, no blur; elevation is tonal stepping only"
    ],
    "dos": [
      "Keep cyan as the only interface accent",
      "Convey elevation with bg → surface → surface-alt tonal steps",
      "Keep type scale within 11px-18px",
      "Use translate-y-px active-press shift for tactile feel",
      "Pack real data into every surface"
    ],
    "donts": [
      "Gradient hero-metric tiles, glassmorphism, cutesy rounded card grids",
      "Ugly, uncalibrated raw sim-overlay density",
      "box-shadow anywhere",
      "Telemetry severity colors on buttons, nav, or chrome",
      "A second accent color to solve a hierarchy problem"
    ]
  }
}
